{
  "name": "subscription-billing-sdet",
  "version": "1.0.0",
  "private": true,
  "description": "Automated validation suite for a Subscription & Billing Service (Kulu SDET assignment)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reliability": "vitest run tests/reliability",
    "validate:schema": "node scripts/validate_schema.js",
    "verify": "npm run lint && npm run typecheck && npm run validate:schema && npm test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "eslint": "9.17.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "^2.1.8"
  }
}
